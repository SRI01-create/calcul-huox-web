# Copier ce fichier en .env et adapter les valeurs

# Origines autorisées par CORS (séparées par des virgules)
# En développement local :
CORS_ORIGINS=http://localhost:5173
# En production (remplacer par l'URL Netlify) :
# CORS_ORIGINS=https://calcul-huox.netlify.app

# Suivi d'usage anonyme (optionnel) — webhook Google Apps Script, voir tracking/Code.gs
# Laisser vide = suivi désactivé (développement local).
TRACKING_URL=
TRACKING_SECRET=
